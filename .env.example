# ─────────────────────────────────────────────────────────────
# Tech Mafia — Environment configuration
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and MUST NOT be committed.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/...)
MONGODB_URI=mongodb+srv://unifiez1_db_user:avZMO29kRmwJAWtt@cluster0.siengx4.mongodb.net/techmafia

# Optional: database name to use inside the cluster
MONGODB_DB=techmafia

# Secret used to sign session + organizer cookies (use a long random string)
JWT_SECRET= ukdfhksdngflkdnfuskdkbfjk

# Passcode the organizer uses to open the admin console
ORGANIZER_PASSCODE=mafia-admin

# ── Code judge (compiles & runs C) ──
# By DEFAULT the app uses the FREE public Judge0 CE instance — no key needed:
#   https://ce.judge0.com
# To use the RapidAPI-hosted Judge0 instead, set JUDGE0_RAPIDAPI_KEY below
# (get a key at https://rapidapi.com/judge0-official/api/judge0-ce). When the
# key is present it is used automatically; otherwise the free instance is used.
#
# Self-hosted Judge0? Point JUDGE0_PUBLIC_URL at it and set JUDGE0_AUTH_TOKEN if it needs one.
JUDGE0_RAPIDAPI_KEY=
# Optional overrides:
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_PUBLIC_URL=https://ce.judge0.com

# Judge0 language id for C (GCC). Leave default unless your instance differs.
JUDGE0_C_LANGUAGE_ID=50

# ── Judge resilience (defaults are fine for a normal event) ──
# Max simultaneous outbound judge requests — protects the shared free instance.
JUDGE_MAX_CONCURRENCY=8
# Free keyless BACKUP judge (Wandbox) is used automatically if Judge0 is down.
JUDGE_FALLBACK=true
# Wandbox only tolerates ~2 simultaneous requests (it 429s beyond that).
JUDGE_FALLBACK_CONCURRENCY=2
# JUDGE_WANDBOX_URL=https://wandbox.org/api/compile.json
# JUDGE_WANDBOX_COMPILER=gcc-13.2.0

# Optional: seconds a heartbeat must be missed before a participant is marked offline
HEARTBEAT_TIMEOUT_SECONDS=20
