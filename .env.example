# ─────────────────────────────────────────────────────────────
# Tech Mafia — Environment configuration
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and MUST NOT be committed.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/...)
MONGODB_URI=mongodb+srv://unifiez1_db_user:avZMO29kRmwJAWtt@cluster0.siengx4.mongodb.net/techmafia

# Optional: database name to use inside the cluster
MONGODB_DB=techmafia

# Secret used to sign session + organizer cookies (use a long random string)
JWT_SECRET= ukdfhksdngflkdnfuskdkbfjk

# Passcode the organizer uses to open the admin console
ORGANIZER_PASSCODE=mafia-admin

# ── Judge0 CE (RapidAPI) — used to compile & run C code ──
# Get a key at https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=

# Judge0 language id for C (GCC 9.2.0). Leave default unless your instance differs.
JUDGE0_C_LANGUAGE_ID=50

# Optional: seconds a heartbeat must be missed before a participant is marked offline
HEARTBEAT_TIMEOUT_SECONDS=20
